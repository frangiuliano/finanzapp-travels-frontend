# API base URL (required for production builds on Vercel)
# Use a relative path so requests go through the same-origin Vercel rewrite
# proxy defined in vercel.json (/api/* -> the Fly.io backend). This keeps the
# refreshToken cookie first-party instead of a cross-site (third-party)
# cookie, which browsers like Safari otherwise block or clear on reload.
# VITE_API_URL=/api

# Local dev: optional if using Vite proxy (defaults to /api)
# VITE_API_URL=http://localhost:8080/api

# Local shell mocks for board switcher (dev only; ignored in production builds)
# VITE_BOARD_MOCKS=true
