# API base URL (required for production builds on Vercel)
# VITE_API_URL=https://finanzapp-travels-backend.fly.dev/api

# Local dev: optional if using Vite proxy (defaults to /api)
# VITE_API_URL=http://localhost:8080/api

# Local shell mocks for board switcher (dev only; ignored in production builds)
# VITE_BOARD_MOCKS=true
